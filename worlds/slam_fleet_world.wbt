#VRML_SIM R2023b utf8

WorldInfo {
  coordinateSystem "ENU"
  basicTimeStep 32
  contactProperties [ ContactProperties { coulombFriction [ 1 ] bounce 0 } ]
  info [
    "Collaborative SLAM + Q-learning: three heterogeneous robots map a 10x10 m arena.",
    "Robots share scans and Q-tables; Q-tables persist between runs.",
    "The supervisor runs episodic randomized training (benchmark_supervisor)."
  ]
}

Viewpoint { orientation 1 0 0 0.9 position 0 -6.5 5.5 }
TexturedBackground { }
TexturedBackgroundLight { }

DEF FLOOR Solid {
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.75 0.75 0.75 roughness 1 metalness 0 } geometry Box { size 10 10 0.1 } } ]
  boundingObject Box { size 10 10 0.1 }
}
