# ------------------------------------------------- episodic benchmark supervisor
DEF BENCHMARK Supervisor {
  translation 0 0 10
  controller "benchmark_supervisor"
  controllerArgs [ "--episodes", "3", "--time-limit", "420", "--target", "90" ]
}
