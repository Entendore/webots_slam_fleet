  translation 0 5.05 0.2
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.55 0.6 roughness 0.8 metalness 0 } geometry Box { size 10.2 0.1 0.4 } } ]
  boundingObject Box { size 10.2 0.1 0.4 }
}
